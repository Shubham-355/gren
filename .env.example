# Copy to .env.local and fill in. The key is read only on the server, inside
# app/api/chat/route.ts, and is never sent to the browser.
# One key, or several separated by commas — however many you paste is how many
# it will use:
#
#   GEMINI_API_KEY=keyone,keytwo,keythree
#
# It uses the first one for everything until that key runs out of quota, then
# hands over to the next and stays there. The switch is invisible to the user.
# A free-tier key allows twenty requests a minute and a single "just file it
# for me" run spends several, so a demo in front of an audience is worth more
# than one key. When every key is spent, Saathi answers from the platform's own
# rules rather than showing an error.
GEMINI_API_KEY=

# Accepted as an alias, for hosts whose secret is already named this way.
GEMINI_API_KEYS=

# Optional. Any model with function calling works; the app adjusts its request
# to suit the family it is pointed at.
#
#   gemini-3.1-flash-lite  default — the cheapest that is still offered to new
#                          keys and still does function calling
#                          ($0.25 / $1.50 per 1M tokens)
#   gemini-3.6-flash       ~3x the input cost, better at long multi-step tool
#                          runs — switch here if Saathi starts dropping steps
#
# Note: gemini-2.5-flash-lite is no longer issued to new keys, and the 2.5
# family takes a zero thinking budget while the 3.x family rejects one. The
# route works that out from the model name, so either generation just works.
#
GEMINI_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------------
# Local model (development only)
# ---------------------------------------------------------------------------
# Set this and `next dev` uses a model running on this machine through Ollama
# instead of spending cloud quota. A demo — and especially a demo recording —
# walks the whole journey many times, and a free cloud key is twenty requests
# a minute.
#
# It is never used in a production build, and it can never make the assistant
# worse: if the local model is not running, is too slow, or returns nothing
# usable, the cloud keys take over for that turn without the user seeing it.
#
#   OLLAMA_MODEL=llama3.2:3b
#
# Pick a model that supports tool calling and fits your GPU. On a 4 GB card
# (GTX 1650) a 3B at Q4 fits entirely in VRAM; an 8B does not and spills into
# system RAM, which is slower and can fail outright when RAM is tight.
OLLAMA_MODEL=

# Where Ollama is listening. Defaults to http://127.0.0.1:11434.
OLLAMA_HOST=

# Context window. This is the memory lever: on an 8B model, 8192 needs about
# 2.4 GiB and 2048 needs about 1.6 GiB. Too small and the system prompt plus
# the live screen state get silently truncated, so the answer degrades. The
# default of 8192 holds both comfortably.
OLLAMA_NUM_CTX=
